# %% Simulação para cada química individualmente
bat_energy_kWh = 5  # Energia total da bateria em kWh

chemistries = ["LFP", "NMC", "LTO", "Sodium"]

print("\n--- Simulação de lifetime para cada química com 5kWh ---")
for chem in chemistries:
    print("\n")
    print(f"--- Resultados para química: {chem} ---")
    n_cells = {c: 0 for c in chemistries}
    cell_row = cells_df[cells_df["Composition"] == chem].iloc[0]
    n_cells[chem] = int((bat_energy_kWh * 1000) / cell_row["E_cell_Wh"])
    bat_df = get_battery_parameters(n_cells, cells_df)
    P_batt, P_grid, P_batt_all, SOC_hist = dispatch_battery(df_cut, bat_df, dt)
    damage, c_rate_mean, c_rate_mean_on, c_rate_max, cycles = compute_damage(P_batt, bat_df, dt, alpha)
    row = bat_df[bat_df["Composition"] == chem].iloc[0]
    life_fraction = damage[chem] / row["Cycles"]
    lifetime_years = 1 / life_fraction if life_fraction > 0 else float('inf')
    print(f"{chem}: Lifetime equivalente: {lifetime_years:.1f} anos, Fração de vida consumida: {life_fraction:.2%}")
    print(f"  C-rate médio: {c_rate_mean[chem]:.2f}, C-rate médio ligado: {c_rate_mean_on[chem]:.2f}, C-rate máximo: {c_rate_max[chem]:.2f}")
    print(f"  Ciclos totais: {cycles[chem]:.1f}, Ciclos por ano (assumindo 1 ano): {cycles[chem]/(len(df_cut)*dt/8760):.1f}")

# %% Problema de otimização de dimensionamento
